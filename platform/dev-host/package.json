{
  "name": "@board-platform/dev-host",
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "description": "Loopback memory development host for independent board games",
  "files": [
    "dist",
    "assets",
    "NOTICE.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src __tests__",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@board-game/contracts": "workspace:*",
    "@board-game/core": "workspace:*",
    "@board-game/host": "workspace:*",
    "@board-game/server": "workspace:*",
    "@board-game/storage": "workspace:*"
  },
  "devDependencies": {
    "@board-game/testing": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
