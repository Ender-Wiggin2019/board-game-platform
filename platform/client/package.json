{
  "name": "@board-platform/client",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./game-pages.js": {
      "types": "./dist/game-pages.d.ts",
      "import": "./dist/game-pages.js"
    },
    "./DevelopmentGameProviders.js": {
      "types": "./dist/DevelopmentGameProviders.d.ts",
      "import": "./dist/DevelopmentGameProviders.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./styles/*": "./dist/styles/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "clean": "rm -rf dist",
    "lint": "biome check src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@board-platform/contracts": "workspace:*",
    "@board-game/client": "workspace:*",
    "@board-game/contracts": "workspace:*",
    "@board-game/components": "workspace:*",
    "@radix-ui/react-select": "2.2.6",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-router": "^1.132.23",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^23.16.8",
    "lucide-react": "^0.259.0",
    "react-dom": "18.3.1",
    "react-i18next": "^13.5.0",
    "react-resizable-panels": "4.12.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.3.1",
    "workbox-window": "7.4.1",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6",
    "@types/node": "^22.18.6",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "vite": "^7.3.5",
    "tsc-alias": "^1.8.17",
    "tailwindcss": "^4.1.15",
    "@tailwindcss/postcss": "^4.1.15",
    "postcss": "^8.5.6"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
